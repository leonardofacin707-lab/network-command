{
  "name": "network-command",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plataforma gamificada de aprendizagem de redes de computadores (JavaScript puro).",
  "scripts": {
    "serve": "node tests/helpers/servidor.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.mjs",
    "build": "node tools/build.mjs",
    "serve:dist": "node tools/servir-dist.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
